FROM oven/bun:1

WORKDIR /app

COPY package.json bun.lockb ./
# --ignore-scripts: skips husky (no .git in the image) and the cloakbrowser binary download
RUN bun install --frozen-lockfile --ignore-scripts

COPY . .
RUN bun run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["bun", ".output/server/index.mjs"]
